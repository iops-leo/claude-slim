{
  "name": "claude-slim",
  "version": "2.8.0",
  "description": "Cut Claude Code startup token overhead — non-destructive scan, tiered proposals, one-command restore. Finds unused skills, duplicate registrations, stale memory, and heavyweight plugins in ~/.claude/.",
  "type": "module",
  "bin": {
    "claude-slim": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "check:versions": "node scripts/check-version-sync.mjs",
    "test:watch": "vitest",
    "demo": "npm run build && bash scripts/demo/fixture.sh && vhs scripts/demo/demo.tape",
    "prepublishOnly": "npm run check:versions && npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "token",
    "token-optimization",
    "context-bloat",
    "prompt-optimization",
    "system-prompt",
    "cleanup",
    "skills",
    "skill-management",
    "plugin",
    "plugin-cleanup",
    "cli",
    "developer-experience"
  ],
  "author": "iops-leo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iops-leo/claude-slim.git"
  },
  "homepage": "https://github.com/iops-leo/claude-slim#readme",
  "bugs": {
    "url": "https://github.com/iops-leo/claude-slim/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "js-tiktoken": "^1.0.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tmp-promise": "^3.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
